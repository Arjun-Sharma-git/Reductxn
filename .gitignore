# --- Gradle ---
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# --- Kotlin / Gradle DSL build state (created by build-logic) ---
.kotlin/

# --- Java ---
*.class
# Anchored to the repository root on purpose. A bare `out/` matches a directory named `out` at ANY
# depth, including `port/out` - which MASTER-PLAN section 5.4 prescribes by name. It excluded two
# source files from a commit with no warning at all: `git add -A` skips ignored paths silently, the
# local build was green, and only a fresh clone failed. `forbidIgnoredSources` now catches it.
/out/

# --- Node / web ---
node_modules/
dist/
.turbo/
coverage/

# --- Test artefacts ---
# jqwik writes a shrinking/statistics database per module. Machine-local, never shared.
.jqwik-database

# --- IDE ---
.idea/
.vscode/
*.iml

# --- Secrets. Never commit these; see ADR 0010 for the key-management posture. ---
.env
.env.local
.env.*.local
*.pem
*.p12
*.jks

# --- OS ---
.DS_Store

# NOTE: generated API clients are deliberately NOT ignored.
# RULE C2 requires them committed so builds are reproducible; CI (RULE C3) fails
# if regeneration produces a diff. Do not add them to this file.
